# TrulyTally AI Environment Configuration

# Gemini API Key for OCR extraction (multimodal vision & document extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (recommended: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Gemini Thinking Level (default: low. Options: minimal, low, medium, high)
GEMINI_THINKING_LEVEL=low

# Gemini 3 Media Resolution (default: high. Options: low, medium, high)
GEMINI_MEDIA_RESOLUTION=high

# Optional: Shared secret key if authenticating tally_connector.py to backend
TALLY_API_KEY=

# Safety: Maximum mathematical validation queries the agent is allowed to execute per invoice (default: 50)
MAX_VALIDATION_QUERIES=50

# ADK 2.0 Workflow ReAct & Loop Limits
MAX_WORKFLOW_REVISIONS=2
AGENT_TIMEOUT=45
